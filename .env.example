# SITE SmartRide local environment template
# Copy to .env and fill these values locally. Never commit .env.

DATABASE_URL=mysql://user:password@host:3306/database
JWT_SECRET=replace-with-a-long-random-secret

# Optional Manus OAuth configuration
VITE_APP_ID=your-manus-app-id
OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_PORTAL_URL=https://oauth.manus.im

# Server-side email configuration (required only when recovery is enabled)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=SmartRide <no-reply@your-verified-domain.example>

# Optional built-in integrations
BUILT_IN_FORGE_API_URL=https://forge.manus.im
BUILT_IN_FORGE_API_KEY=your-server-side-forge-key
VITE_FRONTEND_FORGE_API_URL=https://forge.manus.im
VITE_FRONTEND_FORGE_API_KEY=your-frontend-forge-key
